            "exec": [
              "pm.test(\"Status 401 (sem chave de API)\", () => pm.response.to.have.status(401));",
              "pm.test(\"Nenhum access_token foi retornado\", () => pm.expect(pm.response.text()).to.not.include(\"access_token\"));",
